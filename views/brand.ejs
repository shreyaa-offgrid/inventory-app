<%- include("partials/header", { title: brand.name }) %>

  <a href="/brands">&larr; All brands</a>
  <div class="brand-heading">
    <div>
      <h1>
        <%= brand.name %>
      </h1>
      <p>
        <%= brand.description %>
      </p>
    </div>

    <div class="brand-actions">
      <a class="button button-primary" href="/brands/<%= brand.id %>/edit">
        Edit Brand
      </a>
      <a class="button button-danger" href="/brands/<%= brand.id %>/delete">
        Delete Brand
      </a>
    </div>
  </div>

  <div class="grid">
    <% if(products.length===0){ %>
      <p>No products in this brand yet.</p>
      <% } %>
        <% products.forEach(product=> { %>
          <article class="card">
            <h3>
              <% if (product.source==='product' || !product.source) { %>
                <a href="/products/<%= product.id %>">
                  <%= product.name %>
                </a>
                <% } else { %>
                  <span>
                    <%= product.name %>
                  </span>
                  <% } %>
            </h3>
            <p>Price: <%= product.price %>
            </p>
            <p>Stock: <%= product.stock %>
            </p>
          </article>
          <% }) %>
  </div>

  <%- include("partials/footer") %>